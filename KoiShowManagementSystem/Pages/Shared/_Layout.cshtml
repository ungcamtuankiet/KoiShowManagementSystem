@* @page
@model Pages_Shared__Layout
@{
    ViewData["Title"] = "Layout";
} *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KoiShowManagementSystem</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/KoiShowManagementSystem.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <!-- Center KoiShowManagementSystem -->
                <a class="navbar-brand mx-auto" asp-area="" asp-page="/Index">KoiShowManagementSystem</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navbar Links -->
                <div class="navbar-collapse collapse">
                    <ul class="menu">
                        <li><a href="#">4th Virtual Koi Show</a></li>
                        <li>
                            <a href="#">Previous Shows</a>
                            <ul class="submenu">
                                <li>
                                    <a href="#">Virtual Koi Shows</a>
                                    <ul class="submenu">
                                        <li><a href="#">1st Virtual Koi Show</a></li>
                                        <li><a href="#">2nd Virtual Koi Show</a></li>
                                        <li><a href="#">3rd Virtual Koi Show</a></li>
                                    </ul>
                                </li>
                                <li><a href="#">Virtual Young Koi Shows</a></li>
                                <li><a href="#">Sekiguchi Grow Out Contests</a></li>
                                <li><a href="#">Taniguchi Grow Out Contests</a></li>
                                <li><a href="#">Izumiya Growout 2022</a></li>
                                <li><a href="#">Izumiya/Marusaka Growout 2023</a></li>
                            </ul>
                        </li>
                        <li><a href="#">Contact</a></li>
                    </ul>
                    <ul class="navbar-nav ms-auto">
                        <!-- Conditional Login/Register or Logout buttons aligned to the right -->
                        @if (!string.IsNullOrEmpty(Context.Session.GetString("UserRole")))
                        {
                            <li class="nav-item">
                                <form method="post" asp-page-handler="Logout">
                                    <button type="submit" class="btn btn-danger">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Authen/Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Authen/Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2024 - KoiShowManagementSystem - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
<style>
        * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: Arial, sans-serif;
    }

    nav {
        background-color: #bf0c2d;
        padding: 10px;
    }

    .menu {
        list-style: none;
        display: flex;
        justify-content: space-around;
    }

    .menu > li {
        position: relative;
    }

    .menu a {
        color: white;
        text-decoration: none;
        padding: 15px;
        display: block;
    }

    .menu a:hover {
        background-color: #d21434;
    }

    .submenu {
        list-style: none;
        position: absolute;
        top: 100%;
        left: 0;
        background-color: #bf0c2d;
        display: none;
        padding: 0;
    }

    .submenu li {
        width: 200px;
    }

    .submenu a {
        padding: 10px 15px;
    }

    .menu li:hover .submenu {
        display: block;
    }
</style>