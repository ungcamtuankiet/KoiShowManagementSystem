@* @page
@model Pages_Shared__Layout
@{
    ViewData["Title"] = "Layout";
} *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KoiShowManagementSystem</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/KoiShowManagementSystem.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">KoiShowManagementSystem</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        @{
                            var userRole = Context.Session.GetString("UserRole");
                            var userName = Context.Session.GetString("UserName");
                            var userId = Context.Session.GetInt32("UserId");
                        }
                        @if (!string.IsNullOrEmpty(userRole))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Xin chào, @userName (@userRole Options)
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                    @if (userRole == "Member")
                                    {
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Koi/MyKoiList">View My Koi</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-page="/User/UpdateInformation" asp-route-id="@userId">Edit Profile</a></li>
                                        <li>
                                            <form method="post" asp-page-handler="Logout">
                                                <button type="submit" class="dropdown-item">Logout</button>
                                            </form>
                                        </li>
                                    }
                                    else if (userRole == "Admin")
                                    {
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Account/Index">Manage Account</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Category/Index">Manage Category</a></li>
                                        <li>
                                            <form method="post" asp-page-handler="Logout">
                                                <button type="submit" class="dropdown-item">Logout</button>
                                            </form>
                                        </li>
                                    }
                                    else if (userRole == "Staff")
                                    {
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Staff/Competition/Index">Manage Show</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Staff/ManageKoiRegistration/Index">View Koi Registration Competition</a></li>
                                        <li>
                                            <form method="post" asp-page-handler="Logout">
                                                <button type="submit" class="dropdown-item">Logout</button>
                                            </form>
                                        </li>
                                    }
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Authen/Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Authen/Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2024 - KoiShowManagementSystem - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
<style>
        * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: Arial, sans-serif;
    }

    nav {
        background-color: #bf0c2d;
        padding: 10px;
    }

    .menu {
        list-style: none;
        display: flex;
        justify-content: space-around;
    }

    .menu > li {
        position: relative;
    }

    .menu a {
        color: white;
        text-decoration: none;
        padding: 15px;
        display: block;
    }

    .menu a:hover {
        background-color: #d21434;
    }

    .submenu {
        list-style: none;
        position: absolute;
        top: 100%;
        left: 0;
        background-color: #bf0c2d;
        display: none;
        padding: 0;
    }

    .submenu li {
        width: 200px;
    }

    .submenu a {
        padding: 10px 15px;
    }

    .menu li:hover .submenu {
        display: block;
    }

    header {
        background-color: #f8f9fa; /* Light background for the navbar */
    }

    .navbar {
        padding: 10px 20px; /* Add some padding */
    }

    .navbar-brand {
        font-size: 1.5rem; /* Increase font size for brand */
        font-weight: bold; /* Make the brand bold */
        color: #bf0c2d; /* Set brand color */
    }

    .navbar-nav .nav-link {
        color: #333; /* Dark color for links */
        padding: 10px 15px; /* Add padding to links */
        transition: background-color 0.3s; /* Smooth background color transition */
    }

        .navbar-nav .nav-link:hover {
            background-color: #bf0c2d; /* Change background color on hover */
            color: white; /* Change text color on hover */
            border-radius: 5px; /* Rounded corners for hover effect */
        }

    .dropdown-menu {
        min-width: 200px; /* Set a minimum width for dropdown */
    }

    .dropdown-item {
        transition: background-color 0.3s; /* Smooth background color transition for dropdown items */
    }

        .dropdown-item:hover {
            background-color: #f8f9fa; /* Change background color on hover */
            color: #bf0c2d; /* Change text color on hover */
        }

</style>