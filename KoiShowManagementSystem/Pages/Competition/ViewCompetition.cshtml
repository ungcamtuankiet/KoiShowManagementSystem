@* @page
@model KoiShowManagementSystem.Pages.Competition.ViewCompetitionModel

@{
    ViewData["Title"] = "ViewCompetition";
}

<h1>ViewCompetition</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Competition[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Competition[0].Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Competition[0].StartDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Competition[0].EndDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Competition[0].Location)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Competition[0].Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Competition[0].UpdatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Competition[0].CreatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Competition[0].Category)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Competition) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.StartDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EndDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Location)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UpdatedAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Category.Name)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
 *@