@page
@model KoiShowManagementSystem.Pages.Koi.DeleteKoiModel
@{
    Layout = "_Layout";
}
<form method="post">
    <!-- Ẩn ID Koi cần xóa trong form -->
    <input type="hidden" asp-for="KoiId" value="@Model.KoiId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="/Koi/MyKoiList" class="btn btn-secondary">Cancel</a>
</form>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>


