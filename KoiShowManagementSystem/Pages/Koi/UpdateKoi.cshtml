 @page
@model KoiShowManagementSystem.Pages.Koi.UpdateKoiModel
@{
    Layout = "_Layout";
}

<div class="container mt-5">
    <h2 class="text-center text-primary mb-4">Update Koi Information</h2>

    <form method="post" enctype="multipart/form-data" class="shadow p-4 rounded bg-light">
        <div class="form-group mb-3">
            <label asp-for="UpdateKoiDto.Name" class="form-label fw-bold">Koi Name</label>
            <input asp-for="UpdateKoiDto.Name" class="form-control" />
            <span asp-validation-for="UpdateKoiDto.Name" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="UpdateKoiDto.Variety" class="form-label fw-bold">Koi Variety</label>
            <select asp-for="UpdateKoiDto.Variety" class="form-select" asp-items="Model.koiVarieties">
                <option value="">-- Select Koi Variety --</option>
            </select>
            <span asp-validation-for="UpdateKoiDto.Variety" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="UpdateKoiDto.Size" class="form-label fw-bold">Size (cm)</label>
            <input asp-for="UpdateKoiDto.Size" type="number" class="form-control" />
            <span asp-validation-for="UpdateKoiDto.Size" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="UpdateKoiDto.Description" class="form-label fw-bold">Description</label>
            <textarea asp-for="UpdateKoiDto.Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="UpdateKoiDto.Description" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label class="form-label fw-bold">Current Avatar</label>
            <div class="text-center mb-3">
                <img src="@Model.UpdateKoiDto.Avatar" alt="Koi Avatar" class="img-fluid rounded shadow" style="max-width: 200px;" />
            </div>
        </div>
        <div class="form-group mb-3">
            <label for="avatar" class="form-label fw-bold">Change Avatar (Optional)</label>
            <input type="file" name="UpdateKoiDto.Avatar" id="avatar" class="form-control" />
        </div>

        <div class="d-flex justify-content-between mt-4">
            <button type="submit" class="btn btn-primary">Update Koi</button>
            <a href="/Koi/MyKoiList" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
