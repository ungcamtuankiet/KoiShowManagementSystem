 @page
@model KoiShowManagementSystem.Pages.Koi.DetailModel
@{
}

<div class="container mt-5">
    <h4 class="text-center text-primary mb-4">Koi Fish Information</h4>
    <hr class="mb-4"/>
    <div class="card shadow-lg border-0">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3 text-end fw-bold">Name:</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.KoiFish.Name)</dd>

                <dt class="col-sm-3 text-end fw-bold">Owner:</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.FullNameUser)</dd>

                <dt class="col-sm-3 text-end fw-bold">@Html.DisplayNameFor(model => model.KoiFish.Variety):</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.KoiFish.Variety)</dd>

                <dt class="col-sm-3 text-end fw-bold">@Html.DisplayNameFor(model => model.KoiFish.Size):</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.KoiFish.Size)</dd>

                <dt class="col-sm-3 text-end fw-bold">@Html.DisplayNameFor(model => model.KoiFish.Description):</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.KoiFish.Description)</dd>

                <dt class="col-sm-3 text-end fw-bold">Registration Date:</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.KoiFish.RegistrationDate)</dd>

                <dt class="col-sm-12 text-center mt-4 fw-bold">Koi Fish Image:</dt>
                <dd class="col-sm-12 text-center">
                    <img src="@Model.KoiFish.AvatarUrl" alt="Koi Avatar" class="img-fluid rounded shadow" style="max-width: 300px; height: auto;" />
                </dd>
            </dl>
        </div>
    </div>
    <div class="text-center mt-4">
        <a href="javascript:history.back()" onclick="if(!history.length) this.href='/Index';" class="btn btn-secondary">Return</a>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
