@page
@model KoiListModel
@{
    ViewData["Title"] = "My Koi Fish";
}

<h2>My Koi Fish</h2>

@if (Model.KoiFishList != null && Model.KoiFishList.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Variety</th>
                <th>Size</th>
                <th>Description</th>
                <th>Registration Date</th>
                <th>Image Koi</th>
                <td>Update Koi</td>
                <td>Delete Koi</td>
            </tr>
        </thead>
        <tbody>
            @foreach (var koi in Model.KoiFishList)
            {
                <tr>
                    <td>@koi.Name</td>
                    <td>@koi.Variety</td>
                    <td>@koi.Size</td>
                    <td>@koi.Description</td>
                    <td>@koi.RegistrationDate?.ToString("yyyy-MM-dd")</td>
                    <td>
                        <img src="@Model.@koi.AvatarUrl" alt="Koi Avatar" />
                    </td>
                    <td>
                        <a asp-page="/Koi/UpdateKoi" asp-route-id="@koi.Id">Edit</a>
                    </td>
                    <td>
                        <a asp-page="/Koi/DeleteKoi" asp-route-id="@koi.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <a href="/User/UserPage">Return Home Page</a>
}
else
{
    <p>You have not registered any Koi fish yet.</p>
}