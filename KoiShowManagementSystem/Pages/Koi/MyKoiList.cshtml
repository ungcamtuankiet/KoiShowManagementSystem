@page
@model KoiListModel
@{
    Layout = "_Layout";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">My Koi Fish</h2>
    <div class="d-flex justify-content-between mb-3">
        <a href="/Koi/RegisterKoi" class="btn btn-primary">Add New Koi</a>
        <a href="/Index" class="btn btn-secondary">Return Home Page</a>
    </div>

    @if (Model.KoiFishList != null && Model.KoiFishList.Any())
    {
        <table class="table table-hover table-bordered">
            <thead class="table-dark text-center">
                <tr>
                    <th>Name</th>
                    <th>Variety</th>
                    <th>Size</th>
                    <th>Description</th>
                    <th>Registration Date</th>
                    <th>Status</th>
                    <th>Image</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var koi in Model.KoiFishList)
                {
                    <tr>
                        <td>@koi.Name</td>
                        <td>@koi.Variety</td>
                        <td>@koi.Size</td>
                        <td>@koi.Description</td>
                        <td>@koi.RegistrationDate?.ToString("yyyy-MM-dd")</td>
                        <td>@koi.Status</td>
                        <td class="text-center">
                            <img src="@koi.AvatarUrl" style="width: 50px; height: 50px; object-fit: cover; border-radius: 8px;" alt="Koi Avatar" />
                        </td>
                        <td class="text-center">
                            <a asp-page="/Koi/UpdateKoi" asp-route-id="@koi.Id" class="btn btn-sm btn-warning me-2">Edit</a>
                            <a asp-page="/Koi/DeleteKoi" asp-route-id="@koi.Id" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-center text-muted">You have not registered any Koi fish yet.</p>
    }
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
