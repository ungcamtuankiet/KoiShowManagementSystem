@page
@model ShowResultCompetitionModel
@{
    ViewData["Title"] = "Show Result Competition";
}

<h2>Show Result Competition</h2>

<h3>Bảng Thống Kê Cuộc Thi</h3>
<table>
    <thead>
        <tr>
            <th>Koi id</th>
            <th>CompetitionId</th>
            <th>CategoryId</th>
            <th>Rank</th>
            <th>TotalScore</th>
            <th>Status</th>
            <th>Update Date</th>
            <th>Create Date</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var result in Model.Result)
        {
            <tr>
                <td>@result.KoiId</td>
                <td>@result.CompetitionId</td>
                <td>@result.CategoryId</td>
                <td>@result.Rank</td>
                <td>@result.TotalScore</td>
                <td>@result.Status</td>
                <td>@result.UpdatedAt</td>
                <td>@result.CreatedAt</td>
            </tr>
        }
    </tbody> 
</table>

