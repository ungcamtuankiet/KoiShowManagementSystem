@page
@model KoiShowManagementSystem.Pages.Staff.ManageKoi.IndexModel

@{
    Layout = "_Layout";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">Manage Koi Fish</h2>

    <table class="table table-hover table-bordered">
        <thead class="table-dark text-center">
            <tr>
                <th>Name</th>
                <th>Variety</th>
                <th>Size</th>
                <th>Description</th>
                <th>Registration Date</th>
                <th>Status</th>
                <th>Owner</th>
                <th>Image</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var koi in Model.Kois)
            {
                <tr>
                    <td>@koi.Name</td>
                    <td>@koi.Variety</td>
                    <td>@koi.Size</td>
                    <td>@koi.Description</td>
                    <td>@koi.RegistrationDate?.ToString("yyyy-MM-dd")</td>
                    <td>@koi.Status</td>
                    <td>@koi.User.FullName</td>
                    <td class="text-center">
                        <img src="@koi.AvatarUrl" style="width: 50px; height: 50px; object-fit: cover; border-radius: 8px;" alt="Koi Avatar" />
                    </td>
                    <td class="text-center">
                        <a asp-page="/Staff/ManageKoi/ApprovalKoi" asp-route-id="@koi.Id" class="btn btn-sm btn-warning me-2">Accept</a>
                        <a asp-page="/Staff/ManageKoi/RejectKoi" asp-route-id="@koi.Id" class="btn btn-sm btn-danger">Reject</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>