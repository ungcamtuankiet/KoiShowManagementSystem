@page
@model KoiShowManagementSystem.Pages.Staff.ManageKoiRegistration.IndexModel

@{
    Layout = "_Layout";
}

<h1 class="text-center">Danh sách các cá Koi được đăng kí tham gia cuộc thi</h1>
<table class="table">
    <thead>
        <tr>
            <th>
                Name Competition
            </th>
            <th>
                Owner Koi
            </th>
            <th>
                @Html.DisplayNameFor(model => model.KoiRegistration[0].RegistrationDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.KoiRegistration[0].Status)
            </th>
            <th>
                Detail Koi
            </th>
            <th>
                Action
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.KoiRegistration) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Competition.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.User.FullName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RegistrationDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                <a class="btn btn-sm btn-info" asp-page="/Koi/Detail" asp-route-id="@item.KoiId">Detail Koi</a>
            </td>
            <td>
                    <a class="btn btn-sm btn-success" asp-page="/Staff/ManageKoiRegistration/AcceptKoiRegistration" asp-route-koiRegistrationId="@item.Id" asp-route-competitionId="@item.CompetitionId">Accept</a>
                    <a class="btn btn-sm btn-danger" asp-page="/Staff/ManageKoiRegistration/RejectKoiRegistration" asp-route-koiRegistrationId="@item.Id">Reject</a>
            </td>
        </tr>
}
    </tbody>
</table>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>