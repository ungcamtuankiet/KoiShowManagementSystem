@page
@model KoiShowManagementSystem.Pages.Staff.Competition.StartModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Bắt Đầu Cuộc Thi";
}
<div class="container mt-5">
    <h2 class="text-center mb-4">Bắt Đầu Cuộc Thi</h2>

    <div class="alert alert-warning" role="alert" asp-validation-summary="All"></div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <form method="post">
        <div class="form-group mb-3">
            <label for="competitionId">ID Cuộc Thi:</label>
            <input type="text" class="form-control" id="competitionId" name="competitionId" required />
        </div>

        <button type="submit" class="btn btn-primary">Bắt Đầu</button>
        <a asp-page="/Index" class="btn btn-secondary">Hủy</a>
    </form>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
}
