@page
@model KoiShowManagementSystem.Pages.Staff.Competition.EditModel

@{
    Layout = "_Layout";
}

<h1>Edit</h1>

<h4>Competition</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Competition.Id" />
            <div class="form-group">
                <label asp-for="Competition.Name" class="control-label"></label>
                <input asp-for="Competition.Name" class="form-control" />
                <span asp-validation-for="Competition.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Competition.Description" class="control-label"></label>
                <input asp-for="Competition.Description" class="form-control" />
                <span asp-validation-for="Competition.Description" class="text-danger"></span>
            </div><div class="form-group">
                <label asp-for="Competition.Amount" class="control-label"></label>
                <input asp-for="Competition.Amount" class="form-control" />
                <span asp-validation-for="Competition.Amount" class="text-danger"></span>
            </div> 
            <div class="form-group">
                <label asp-for="Competition.StartDate" class="control-label"></label>
                <input asp-for="Competition.StartDate" class="form-control" />
                <span asp-validation-for="Competition.StartDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Competition.EndDate" class="control-label"></label>
                <input asp-for="Competition.EndDate" class="form-control" />
                <span asp-validation-for="Competition.EndDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Competition.Location" class="control-label"></label>
                <input asp-for="Competition.Location" class="form-control" />
                <span asp-validation-for="Competition.Location" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Competition.Status" class="control-label"></label>
                <input asp-for="Competition.Status" class="form-control" />
                <span asp-validation-for="Competition.Status" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Competition.CategoryId" class="control-label"></label>
                <select asp-for="Competition.CategoryId" class="form-control" asp-items="ViewBag.CategoryId"></select>
                <span asp-validation-for="Competition.CategoryId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
}
