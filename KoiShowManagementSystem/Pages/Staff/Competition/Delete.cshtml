@page
@model KoiShowManagementSystem.Pages.Staff.Competition.DeleteModel

@{
    Layout = "_Layout";
}

<h1 class="text-center my-4">Delete Competition</h1>

<div class="container">
    <h3 class="text-danger">Are you sure you want to delete this competition?</h3>
    <div>
        <h4>Competition Details</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Competition.Name)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Competition.Name)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Competition.Description)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Competition.Description)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Competition.Amount)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Competition.Amount)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Competition.StartDate)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Competition.StartDate)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Competition.EndDate)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Competition.EndDate)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Competition.Location)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Competition.Location)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Competition.Status)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Competition.Status)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Competition.UpdatedAt)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Competition.UpdatedAt)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Competition.CreatedAt)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Competition.CreatedAt)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Competition.Category.Name)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Competition.Category.Name)</dd>
        </dl>

        <form method="post" class="mt-4">
            <input type="hidden" asp-for="Competition.Id" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a class="btn btn-secondary ms-2" asp-page="./Index">Back to List</a>
        </form>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
