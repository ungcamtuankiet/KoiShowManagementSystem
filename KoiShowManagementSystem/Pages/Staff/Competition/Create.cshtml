@page
@model KoiShowManagementSystem.Pages.Staff.Competition.CreateModel

@{
    Layout = "_Layout";
}

<h1 class="text-center my-4">Create Competition</h1>

<div class="container">
    <h4 class="mb-3">Competition Details</h4>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group mb-3">
                    <label asp-for="Competition.Name" class="form-label"></label>
                    <input asp-for="Competition.Name" class="form-control" placeholder="Enter competition name" />
                    <span asp-validation-for="Competition.Name" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Competition.Description" class="form-label"></label>
                    <input asp-for="Competition.Description" class="form-control" placeholder="Enter competition description" />
                    <span asp-validation-for="Competition.Description" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Competition.Amount" class="form-label"></label>
                    <input asp-for="Competition.Amount" class="form-control" placeholder="Enter prize amount" />
                    <span asp-validation-for="Competition.Amount" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Competition.StartDate" class="form-label"></label>
                    <input asp-for="Competition.StartDate" class="form-control" type="date" />
                    <span asp-validation-for="Competition.StartDate" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Competition.EndDate" class="form-label"></label>
                    <input asp-for="Competition.EndDate" class="form-control" type="date" />
                    <span asp-validation-for="Competition.EndDate" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Competition.Location" class="form-label"></label>
                    <input asp-for="Competition.Location" class="form-control" placeholder="Enter competition location" />
                    <span asp-validation-for="Competition.Location" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Competition.CategoryId" class="form-label">Category</label>
                    <select asp-for="Competition.CategoryId" class="form-control" asp-items="ViewBag.CategoryId"></select>
                </div>

                <div class="form-group">
                    <input type="submit" value="Create" class="btn btn-success" />
                </div>
            </form>
        </div>
    </div>

    <div class="mt-3">
        <a asp-page="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
}
