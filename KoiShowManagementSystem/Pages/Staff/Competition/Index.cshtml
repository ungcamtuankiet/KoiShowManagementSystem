@page
@model KoiShowManagementSystem.Pages.Staff.Competition.IndexModel

@{
    Layout = "_Layout";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Competition[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Competition[0].Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Competition[0].Amount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Competition[0].StartDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Competition[0].EndDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Competition[0].Location)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Competition[0].Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Competition[0].UpdatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Competition[0].CreatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Competition[0].Category)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Competition) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Amount)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.StartDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EndDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Location)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UpdatedAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Category.Name)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
<a asp-page="/Index">Return Home Page</a>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
