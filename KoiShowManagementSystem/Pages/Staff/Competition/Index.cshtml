@page
@model KoiShowManagementSystem.Pages.Staff.Competition.IndexModel

@{
    Layout = "_Layout";
}

<h1 class="text-center my-4">Competition Index</h1>

<div class="d-flex justify-content-between mb-3">
    <a class="btn btn-primary" asp-page="Create">Create New Competition</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.Competition[0].Name)</th>
                <th>@Html.DisplayNameFor(model => model.Competition[0].Description)</th>
                <th>@Html.DisplayNameFor(model => model.Competition[0].Amount)</th>
                <th>@Html.DisplayNameFor(model => model.Competition[0].StartDate)</th>
                <th>@Html.DisplayNameFor(model => model.Competition[0].EndDate)</th>
                <th>@Html.DisplayNameFor(model => model.Competition[0].Location)</th>
                <th>@Html.DisplayNameFor(model => model.Competition[0].Status)</th>
                <th>@Html.DisplayNameFor(model => model.Competition[0].UpdatedAt)</th>
                <th>@Html.DisplayNameFor(model => model.Competition[0].CreatedAt)</th>
                <th>@Html.DisplayNameFor(model => model.Competition[0].Category)</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Competition)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Name)</td>
                    <td>@Html.DisplayFor(modelItem => item.Description)</td>
                    <td>@Html.DisplayFor(modelItem => item.Amount)</td>
                    <td>@Html.DisplayFor(modelItem => item.StartDate)</td>
                    <td>@Html.DisplayFor(modelItem => item.EndDate)</td>
                    <td>@Html.DisplayFor(modelItem => item.Location)</td>
                    <td>@Html.DisplayFor(modelItem => item.Status)</td>
                    <td>@Html.DisplayFor(modelItem => item.UpdatedAt)</td>
                    <td>@Html.DisplayFor(modelItem => item.CreatedAt)</td>
                    <td>@Html.DisplayFor(modelItem => item.Category.Name)</td>
                    <td>
                        <a class="btn btn-sm btn-warning" asp-page="./Edit" asp-route-id="@item.Id">Edit</a>
                        <a class="btn btn-sm btn-info" asp-page="./Details" asp-route-id="@item.Id">Details</a>
                        <a class="btn btn-sm btn-danger" asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
                        <a class="btn btn-sm btn-success" asp-page="./Start" asp-route-id="@item.Id">Start Competition</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="text-center my-4">
    <a class="btn btn-secondary" asp-page="/Index">Return to Home Page</a>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
