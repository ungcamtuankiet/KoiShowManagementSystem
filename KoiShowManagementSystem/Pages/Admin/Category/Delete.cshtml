@page
@model KoiShowManagementSystem.Pages.Category.DeleteModel
@{
}

<h2>Delete Category</h2>

<h3>Are you sure you want to delete the category: <strong>@Model.CategoryName</strong>?</h3>

<form method="post">
    <input type="hidden" asp-for="CategoryId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="/Admin/Category/Index" class="btn btn-secondary">Cancel</a>
</form>
