@page
@model IndexModel
@{
    ViewData["Title"] = "Trang Chủ - Koi Show Management";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-light border-bottom box-shadow mb-3">
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav flex-grow-1">

                </ul>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            <h1 class="text-center">Chào Mừng Đến Với Cuộc Thi Cá Koi</h1>
            <p class="lead text-center">@Model.CompetitionInfo</p>

            <h2 class="section-title">Giải thưởng</h2>
            <ul class="list-group mb-4">
                @foreach (var prize in Model.Prizes)
                {
                    <li class="list-group-item">@prize</li>
                }
            </ul>

            <h2 class="section-title">Luật thi đấu</h2>
            <div>@Html.Raw(Model.Rules)</div>

            <h2 class="section-title">Tiêu chí chấm điểm</h2>
            <div>@Html.Raw(Model.ScoringCriteria)</div>

            <h2 class="section-title">Tin tức</h2>
            <ul class="list-group">
                @foreach (var news in Model.News)
                {
                    <li class="list-group-item">@news</li>
                }
            </ul>
        </main>
    </div>
    <footer class="border-top footer text-muted">
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>